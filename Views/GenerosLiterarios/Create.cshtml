@model PAV_PF_KendallBonilla_RandyArtavia.Models.GenerosLiterarios

@{
    ViewBag.Title = "Crear Genero";
}

@using (Html.BeginForm("Create", "GenerosLiterarios", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(model => model.CodigoGenero, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.CodigoGenero, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.CodigoGenero, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.DescripcionGenero, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.DescripcionGenero, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.DescripcionGenero, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Guardar" class="btn btn-primary" />
        </div>
    </div>
}
