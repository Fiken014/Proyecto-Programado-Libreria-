@model PAV_PF_KendallBonilla_RandyArtavia.Models.Ventas

@{
    ViewBag.Title = "Detalles de la Venta";
    decimal totalSinIVA = Model.DetalleVentas.Sum(d => d.Subtotal);
    decimal iva = totalSinIVA * 0.13m;
    decimal totalConIVA = totalSinIVA + iva;
}

<div class="container my-5">

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Información de la Venta</h4>
        </div>
        <div class="card-body">
            <p><strong>Número de Factura:</strong> @Model.NumeroFactura</p>
            <p><strong>Fecha de Compra:</strong> @Model.FechaCompra.ToString("dd/MM/yyyy")</p>
            <p><strong>Usuario:</strong> @Model.UsuarioID</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-secondary text-white">
            <h4 class="mb-0">Libros Adquiridos</h4>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Libro</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in Model.DetalleVentas.Distinct())
                    {
                        <tr>
                            <td>@detalle.Libros.NombreLibro</td>
                            <td>@detalle.Cantidad</td>
                            <td>₡ @detalle.Libros.Precio.ToString("N2")</td>
                            <td>₡ @detalle.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-end">
            <h5>Total sin IVA: ₡ @totalSinIVA.ToString("N2")</h5>
            <h5>IVA (13%): ₡ @iva.ToString("N2")</h5>
            <h5>Total con IVA: ₡ @totalConIVA.ToString("N2")</h5>
        </div>
    </div>

    <div class="text-end mt-3">
        @Html.ActionLink("Volver a la Lista", "Index", null, new { @class = "btn btn-secondary" })
    </div>
</div>
